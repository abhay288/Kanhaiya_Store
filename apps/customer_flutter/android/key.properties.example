# Production Keystore Configuration Template for Kanhaiya General Store Android App
#
# INSTRUCTIONS:
# 1. Generate an upload keystore if you don't already have one:
#    keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2. Copy this file to "key.properties" in the "apps/customer_flutter/android" directory:
#    cp key.properties.example key.properties
#
# 3. Fill in the actual credentials below (key.properties is git-ignored):
#
# 4. Generate the production Android App Bundle:
#    flutter build appbundle --release --dart-define=API_BASE_URL=https://api.kanhaiyastore.com/api/v1 --dart-define=USE_MOCK_REPO=false

storePassword=YOUR_SECURE_KEYSTORE_PASSWORD
keyPassword=YOUR_SECURE_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks

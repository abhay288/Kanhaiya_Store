# Server Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas Connection URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kanhaiya_store

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CUSTOMER_APP_ORIGIN=http://localhost:3000
CUSTOMER_PWA_ORIGIN=http://localhost:5173

# Application Authentication Secrets
JWT_SECRET=replace_with_strong_cryptographic_secret_in_production
ADMIN_ALLOWED_EMAILS=kanhaiyaastore@gmail.com

# Firebase Authentication & Admin SDK
FIREBASE_PROJECT_ID=kanhaiya-store-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@kanhaiya-store-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Cloudinary CDN (Asset hosting in later phases)
CLOUDINARY_CLOUD_NAME=kanhaiya-store
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Store Operations
STORE_NAME="Kanhaiya General Store"
STORE_PHONE="9936269347"
